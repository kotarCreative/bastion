{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bastion-catalog-smoke",
  "main": "test/remote-worker.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "CATALOG", "class_name": "ForgeCatalog" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ForgeCatalog"] }],
  "observability": { "enabled": true, "traces": { "enabled": true } }
}

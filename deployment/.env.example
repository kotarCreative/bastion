# Docker deployment ----------------------------------------------------------

# Public DNS name, or localhost for a local TLS certificate.
BASTION_HOST=localhost

# Use 80 and 443 on a public host. Defaults avoid privileged host ports.
BASTION_HTTP_PORT=8080
BASTION_HTTPS_PORT=8443

# Cloudflare deployment ------------------------------------------------------

# Long random value used only to authorize the one-time provisioning request.
# Generate one with: openssl rand -hex 32
BASTION_ADMIN_SECRET=replace-with-a-random-secret

# Verified Clerk email that will claim the initial administrator account.
BASTION_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Clerk authentication -------------------------------------------------------

# Values from Clerk Dashboard > API keys.
CLERK_PUBLISHABLE_KEY=pk_test_replace-me
CLERK_SECRET_KEY=sk_test_replace-me

# Exact comma-separated application origins, with no trailing slash.
# Use the deployed HTTPS origin in production.
CLERK_AUTHORIZED_PARTIES=https://localhost:8443

# Optional Clerk JWKS public key for verification without a network lookup.
# Preserve the PEM newlines when entering this with `wrangler secret put`.
CLERK_JWT_KEY=
